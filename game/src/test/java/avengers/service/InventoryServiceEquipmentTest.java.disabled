package avengers.service;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;

import avengers.domain.model.Item;
import avengers.domain.model.Player;
import avengers.domain.model.Player.EquipmentSlot;
import avengers.domain.model.World;
import avengers.domain.utils.CommandResult;
import avengers.domain.utils.GameContext;
import java.util.Optional;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;

/** Unit tests for InventoryService equipment functionality. */
class InventoryServiceEquipmentTest {

  private InventoryService inventoryService;
  private GameContext mockContext;
  private Player mockPlayer;
  private World mockWorld;
  private Item weaponItem;
  private Item armorItem;
  private Item artifactItem;
  private Item consumableItem;

  @BeforeEach
  void setUp() {
    inventoryService = new InventoryService();
    mockContext = mock(GameContext.class);
    mockPlayer = mock(Player.class);
    mockWorld = mock(World.class);

    when(mockContext.player()).thenReturn(mockPlayer);
    when(mockContext.world()).thenReturn(mockWorld);

    // Create test items
    weaponItem =
        new Item("WEAPON-01", "Iron Sword", "A sharp iron sword", "Weapon", "+10 Attack", "");
    armorItem =
        new Item("ARMOR-01", "Leather Armor", "Basic leather armor", "Armor", "+5 Defense", "");
    artifactItem =
        new Item("ARTIFACT-01", "Ring of Health", "Increases health", "Artifact", "+20 HP", "");
    consumableItem =
        new Item("CONSUMABLE-01", "Health Potion", "Restores health", "Consumable", "+50 HP", "");
  }

  @Test
  void testEquipItem_success() {
    // Setup: Player has weapon in inventory
    when(mockPlayer.getInventoryItemIds()).thenReturn(java.util.List.of("WEAPON-01"));
    when(mockWorld.findItem("WEAPON-01")).thenReturn(Optional.of(weaponItem));
    when(mockPlayer.hasEquippedItem(EquipmentSlot.WEAPON)).thenReturn(false);

    CommandResult result = inventoryService.equipItem(mockContext, "Iron Sword");

    assertTrue(result.success());
    assertTrue(result.message().contains("You equipped the Iron Sword (WEAPON)"));
    verify(mockPlayer).removeItemFromInventory("WEAPON-01");
    verify(mockPlayer).equipItem(EquipmentSlot.WEAPON, "WEAPON-01");
  }

  @Test
  void testEquipItem_replaceExisting() {
    // Setup: Player has new weapon in inventory and old weapon equipped
    when(mockPlayer.getInventoryItemIds()).thenReturn(java.util.List.of("WEAPON-02"));
    when(mockWorld.findItem("WEAPON-02"))
        .thenReturn(
            Optional.of(
                new Item("WEAPON-02", "Steel Sword", "A steel sword", "Weapon", "+15 Attack", "")));
    when(mockWorld.findItem("WEAPON-01")).thenReturn(Optional.of(weaponItem));
    when(mockPlayer.hasEquippedItem(EquipmentSlot.WEAPON)).thenReturn(true);
    when(mockPlayer.getEquippedItem(EquipmentSlot.WEAPON)).thenReturn("WEAPON-01");

    CommandResult result = inventoryService.equipItem(mockContext, "Steel Sword");

    assertTrue(result.success());
    assertTrue(result.message().contains("You equipped the Steel Sword (WEAPON)"));
    assertTrue(result.message().contains("Iron Sword was returned to your inventory"));
    verify(mockPlayer).removeItemFromInventory("WEAPON-02");
    verify(mockPlayer).equipItem(EquipmentSlot.WEAPON, "WEAPON-02");
    verify(mockPlayer).addItemToInventory("WEAPON-01");
  }

  @Test
  void testEquipItem_itemNotInInventory() {
    when(mockPlayer.getInventoryItemIds()).thenReturn(java.util.List.of());

    CommandResult result = inventoryService.equipItem(mockContext, "Iron Sword");

    assertFalse(result.success());
    assertEquals("You don't have an item called 'Iron Sword' in your inventory.", result.message());
  }

  @Test
  void testEquipItem_itemNotEquippable() {
    // Setup: Player has consumable in inventory
    when(mockPlayer.getInventoryItemIds()).thenReturn(java.util.List.of("CONSUMABLE-01"));
    when(mockWorld.findItem("CONSUMABLE-01")).thenReturn(Optional.of(consumableItem));

    CommandResult result = inventoryService.equipItem(mockContext, "Health Potion");

    assertFalse(result.success());
    assertEquals("Item cannot be equipped.", result.message());
  }

  @Test
  void testEquipItem_unknownCategory() {
    Item unknownItem =
        new Item("UNKNOWN-01", "Mystery Item", "Unknown item", "Unknown", "+5 Magic", "");
    when(mockPlayer.getInventoryItemIds()).thenReturn(java.util.List.of("UNKNOWN-01"));
    when(mockWorld.findItem("UNKNOWN-01")).thenReturn(Optional.of(unknownItem));

    CommandResult result = inventoryService.equipItem(mockContext, "Mystery Item");

    assertFalse(result.success());
    assertEquals("Item cannot be equipped to any slot.", result.message());
  }

  @Test
  void testUnequipItem_success() {
    // Setup: Player has weapon equipped
    when(mockPlayer.hasEquippedItem(EquipmentSlot.WEAPON)).thenReturn(true);
    when(mockPlayer.unequipItem(EquipmentSlot.WEAPON)).thenReturn("WEAPON-01");
    when(mockWorld.findItem("WEAPON-01")).thenReturn(Optional.of(weaponItem));

    CommandResult result = inventoryService.unequipItem(mockContext, "WEAPON");

    assertTrue(result.success());
    assertTrue(result.message().contains("You unequipped the Iron Sword from the WEAPON slot"));
    verify(mockPlayer).unequipItem(EquipmentSlot.WEAPON);
    verify(mockPlayer).addItemToInventory("WEAPON-01");
  }

  @Test
  void testUnequipItem_emptySlot() {
    when(mockPlayer.hasEquippedItem(EquipmentSlot.WEAPON)).thenReturn(false);

    CommandResult result = inventoryService.unequipItem(mockContext, "WEAPON");

    assertFalse(result.success());
    assertEquals("No item is equipped in the WEAPON slot.", result.message());
  }

  @Test
  void testUnequipItem_invalidSlot() {
    CommandResult result = inventoryService.unequipItem(mockContext, "INVALID");

    assertFalse(result.success());
    assertTrue(result.message().contains("Invalid equipment slot: INVALID"));
    assertTrue(result.message().contains("Valid slots are: WEAPON, ARMOR, ARTIFACT"));
  }

  @Test
  void testUnequipItem_caseInsensitive() {
    when(mockPlayer.hasEquippedItem(EquipmentSlot.ARMOR)).thenReturn(true);
    when(mockPlayer.unequipItem(EquipmentSlot.ARMOR)).thenReturn("ARMOR-01");
    when(mockWorld.findItem("ARMOR-01")).thenReturn(Optional.of(armorItem));

    CommandResult result = inventoryService.unequipItem(mockContext, "armor");

    assertTrue(result.success());
    assertTrue(result.message().contains("You unequipped the Leather Armor from the ARMOR slot"));
  }

  @Test
  void testDetermineEquipmentSlot_weapon() {
    // This tests the private method indirectly through equipItem
    when(mockPlayer.getInventoryItemIds()).thenReturn(java.util.List.of("WEAPON-01"));
    when(mockWorld.findItem("WEAPON-01")).thenReturn(Optional.of(weaponItem));
    when(mockPlayer.hasEquippedItem(EquipmentSlot.WEAPON)).thenReturn(false);

    CommandResult result = inventoryService.equipItem(mockContext, "Iron Sword");

    assertTrue(result.success());
    verify(mockPlayer).equipItem(EquipmentSlot.WEAPON, "WEAPON-01");
  }

  @Test
  void testDetermineEquipmentSlot_armor() {
    when(mockPlayer.getInventoryItemIds()).thenReturn(java.util.List.of("ARMOR-01"));
    when(mockWorld.findItem("ARMOR-01")).thenReturn(Optional.of(armorItem));
    when(mockPlayer.hasEquippedItem(EquipmentSlot.ARMOR)).thenReturn(false);

    CommandResult result = inventoryService.equipItem(mockContext, "Leather Armor");

    assertTrue(result.success());
    verify(mockPlayer).equipItem(EquipmentSlot.ARMOR, "ARMOR-01");
  }

  @Test
  void testDetermineEquipmentSlot_artifact() {
    when(mockPlayer.getInventoryItemIds()).thenReturn(java.util.List.of("ARTIFACT-01"));
    when(mockWorld.findItem("ARTIFACT-01")).thenReturn(Optional.of(artifactItem));
    when(mockPlayer.hasEquippedItem(EquipmentSlot.ARTIFACT)).thenReturn(false);

    CommandResult result = inventoryService.equipItem(mockContext, "Ring of Health");

    assertTrue(result.success());
    verify(mockPlayer).equipItem(EquipmentSlot.ARTIFACT, "ARTIFACT-01");
  }

  @Test
  void testEquipItem_findByItemId() {
    // Test finding item by ID instead of name
    when(mockPlayer.getInventoryItemIds()).thenReturn(java.util.List.of("WEAPON-01"));
    when(mockWorld.findItem("WEAPON-01")).thenReturn(Optional.of(weaponItem));
    when(mockPlayer.hasEquippedItem(EquipmentSlot.WEAPON)).thenReturn(false);

    CommandResult result = inventoryService.equipItem(mockContext, "WEAPON-01");

    assertTrue(result.success());
    verify(mockPlayer).equipItem(EquipmentSlot.WEAPON, "WEAPON-01");
  }

  @Test
  void testUnequipItem_itemNotFoundInWorld() {
    // Test when unequipped item is not found in world (should still work)
    when(mockPlayer.hasEquippedItem(EquipmentSlot.WEAPON)).thenReturn(true);
    when(mockPlayer.unequipItem(EquipmentSlot.WEAPON)).thenReturn("WEAPON-01");
    when(mockWorld.findItem("WEAPON-01")).thenReturn(Optional.empty());

    CommandResult result = inventoryService.unequipItem(mockContext, "WEAPON");

    assertTrue(result.success());
    assertTrue(result.message().contains("You unequipped the WEAPON-01 from the WEAPON slot"));
    verify(mockPlayer).addItemToInventory("WEAPON-01");
  }
}
