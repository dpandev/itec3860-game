package avengers.integration;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;

import avengers.client.command.InputCommandParser;
import avengers.client.controller.InventoryController;
import avengers.domain.model.Item;
import avengers.domain.model.Player;
import avengers.domain.model.World;
import avengers.domain.utils.CommandResult;
import avengers.domain.utils.CommandToken;
import avengers.domain.utils.GameContext;
import avengers.domain.utils.Verb;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;

/**
 * Integration tests for the equipment system end-to-end flow.
 * Tests: Command Parsing → InventoryController → InventoryService → Player
 */
class EquipmentIntegrationTest {

  private InputCommandParser parser;
  private InventoryController controller;
  private GameContext gameContext;
  private Player player;
  private World world;

  @BeforeEach
  void setUp() {
    parser = new InputCommandParser();
    controller = new InventoryController();
    
    // Create test player and world
    player = new Player("TestPlayer", "room1");
    world = mock(World.class);
    gameContext = new GameContext(player, world);
    
    // Create test items
    Item sword = new Item("sword1", "Iron Sword", "A sharp iron sword", "Weapon", "+15 Attack", "");
    Item armor = new Item("armor1", "Leather Armor", "Basic leather armor", "Armor", "+10 Defense", "");
    Item artifact = new Item("artifact1", "Magic Ring", "A mystical ring", "Artifact", "+5 Attack, +5 Defense", "");
    
    // Mock world to return test items
    when(world.findItem("sword1")).thenReturn(sword);
    when(world.findItem("armor1")).thenReturn(armor);
    when(world.findItem("artifact1")).thenReturn(artifact);
    when(world.findItemByName("Iron Sword")).thenReturn(sword);
    when(world.findItemByName("Leather Armor")).thenReturn(armor);
    when(world.findItemByName("Magic Ring")).thenReturn(artifact);
    
    // Add items to player inventory
    player.addItemToInventory("sword1");
    player.addItemToInventory("armor1");
    player.addItemToInventory("artifact1");
  }

  @Test
  void testEquipCommandFlow() {
    // Test: "equip Iron Sword" → CommandParser → InventoryController → InventoryService → Player
    
    // 1. Parse command
    CommandToken token = parser.parse("equip Iron Sword");
    assertEquals(Verb.EQUIP, token.verb());
    assertEquals("Iron Sword", token.target());
    
    // 2. Verify controller supports the command
    assertTrue(controller.supports(token.verb()));
    
    // 3. Handle command through controller
    CommandResult result = controller.handle(token, gameContext);
    
    // 4. Verify successful result
    assertTrue(result.success());
    assertTrue(result.message().contains("equipped"));
    
    // 5. Verify player state changes
    assertEquals("sword1", player.getEquippedItems().get(Player.EquipmentSlot.WEAPON));
    assertFalse(player.hasItemInInventory("sword1")); // Item removed from inventory
    
    // 6. Verify stat bonuses are applied
    assertEquals(115, player.getTotalAttack(world)); // 100 base + 15 from sword
  }

  @Test
  void testUnequipCommandFlow() {
    // First equip an item
    player.equipItem(Player.EquipmentSlot.WEAPON, "sword1");
    player.removeItemFromInventory("sword1");
    
    // Test: "unequip weapon" → CommandParser → InventoryController → InventoryService → Player
    
    // 1. Parse command
    CommandToken token = parser.parse("unequip weapon");
    assertEquals(Verb.UNEQUIP, token.verb());
    assertEquals("weapon", token.target());
    
    // 2. Handle command through controller
    CommandResult result = controller.handle(token, gameContext);
    
    // 3. Verify successful result
    assertTrue(result.success());
    assertTrue(result.message().contains("unequipped"));
    
    // 4. Verify player state changes
    assertNull(player.getEquippedItems().get(Player.EquipmentSlot.WEAPON));
    assertTrue(player.hasItemInInventory("sword1")); // Item returned to inventory
    
    // 5. Verify stat bonuses are removed
    assertEquals(100, player.getTotalAttack(world)); // Back to base attack
  }

  @Test
  void testEquipSlotConflictFlow() {
    // First equip a weapon
    CommandToken equipSword = parser.parse("equip Iron Sword");
    CommandResult result1 = controller.handle(equipSword, gameContext);
    assertTrue(result1.success());
    
    // Create another weapon
    Item axe = new Item("axe1", "Battle Axe", "A heavy battle axe", "Weapon", "+20 Attack", "");
    when(world.findItemByName("Battle Axe")).thenReturn(axe);
    when(world.findItem("axe1")).thenReturn(axe);
    player.addItemToInventory("axe1");
    
    // Test equipping second weapon (should swap)
    CommandToken equipAxe = parser.parse("equip Battle Axe");
    CommandResult result2 = controller.handle(equipAxe, gameContext);
    
    // Verify swap occurred
    assertTrue(result2.success());
    assertTrue(result2.message().contains("swapped"));
    assertEquals("axe1", player.getEquippedItems().get(Player.EquipmentSlot.WEAPON));
    assertTrue(player.hasItemInInventory("sword1")); // Previous weapon returned to inventory
    assertFalse(player.hasItemInInventory("axe1")); // New weapon equipped
    
    // Verify new stat bonuses
    assertEquals(120, player.getTotalAttack(world)); // 100 base + 20 from axe
  }

  @Test
  void testMultipleEquipmentBonuses() {
    // Equip multiple items with different bonuses
    CommandResult swordResult = controller.handle(parser.parse("equip Iron Sword"), gameContext);
    CommandResult armorResult = controller.handle(parser.parse("equip Leather Armor"), gameContext);
    CommandResult ringResult = controller.handle(parser.parse("equip Magic Ring"), gameContext);
    
    assertTrue(swordResult.success());
    assertTrue(armorResult.success());
    assertTrue(ringResult.success());
    
    // Verify all items are equipped
    assertEquals("sword1", player.getEquippedItems().get(Player.EquipmentSlot.WEAPON));
    assertEquals("armor1", player.getEquippedItems().get(Player.EquipmentSlot.ARMOR));
    assertEquals("artifact1", player.getEquippedItems().get(Player.EquipmentSlot.ARTIFACT));
    
    // Verify cumulative stat bonuses
    // Sword: +15 Attack, Armor: +10 Defense, Ring: +5 Attack, +5 Defense
    assertEquals(120, player.getTotalAttack(world)); // 100 + 15 + 5
    assertEquals(115, player.getTotalDefense(world)); // 100 + 10 + 5
  }

  @Test
  void testInventoryCommandWithEquippedItems() {
    // Equip some items
    controller.handle(parser.parse("equip Iron Sword"), gameContext);
    controller.handle(parser.parse("equip Leather Armor"), gameContext);
    
    // Test inventory command shows equipped items
    CommandToken inventoryToken = parser.parse("inventory");
    CommandResult result = controller.handle(inventoryToken, gameContext);
    
    assertTrue(result.success());
    assertTrue(result.message().contains("EQUIPPED ITEMS"));
    assertTrue(result.message().contains("WEAPON: Iron Sword"));
    assertTrue(result.message().contains("ARMOR: Leather Armor"));
  }

  @Test
  void testErrorHandling() {
    // Test equipping non-existent item
    CommandResult result1 = controller.handle(parser.parse("equip Nonexistent Item"), gameContext);
    assertFalse(result1.success());
    assertTrue(result1.message().contains("not found"));
    
    // Test unequipping empty slot
    CommandResult result2 = controller.handle(parser.parse("unequip weapon"), gameContext);
    assertFalse(result2.success());
    assertTrue(result2.message().contains("No item equipped"));
    
    // Test equipping non-equippable item
    Item potion = new Item("potion1", "Health Potion", "Restores health", "Consumable", "+20 HP", "");
    when(world.findItemByName("Health Potion")).thenReturn(potion);
    when(world.findItem("potion1")).thenReturn(potion);
    player.addItemToInventory("potion1");
    
    CommandResult result3 = controller.handle(parser.parse("equip Health Potion"), gameContext);
    assertFalse(result3.success());
    assertTrue(result3.message().contains("cannot be equipped"));
  }
}
