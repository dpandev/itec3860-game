package avengers.domain.model;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;

import avengers.domain.model.Player.EquipmentSlot;
import java.util.Optional;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;

/** Unit tests for Player equipment functionality. */
class PlayerEquipmentTest {

  private Player player;
  private World mockWorld;
  private Item weaponItem;
  private Item armorItem;
  private Item artifactItem;

  @BeforeEach
  void setUp() {
    player = new Player("TestPlayer", "ROOM-01");
    mockWorld = mock(World.class);

    // Create test items with stat bonuses
    weaponItem =
        new Item("WEAPON-01", "Iron Sword", "A sharp iron sword", "Weapon", "+10 Attack", "");
    armorItem =
        new Item("ARMOR-01", "Leather Armor", "Basic leather armor", "Armor", "+5 Defense", "");
    artifactItem =
        new Item("ARTIFACT-01", "Ring of Health", "Increases health", "Artifact", "+20 HP", "");

    // Mock world to return items
    when(mockWorld.findItem("WEAPON-01")).thenReturn(Optional.of(weaponItem));
    when(mockWorld.findItem("ARMOR-01")).thenReturn(Optional.of(armorItem));
    when(mockWorld.findItem("ARTIFACT-01")).thenReturn(Optional.of(artifactItem));
  }

  @Test
  void testEquipItem_success() {
    // Equip weapon
    String previousItem = player.equipItem(EquipmentSlot.WEAPON, "WEAPON-01");

    assertNull(previousItem); // No previous item
    assertTrue(player.hasEquippedItem(EquipmentSlot.WEAPON));
    assertEquals("WEAPON-01", player.getEquippedItem(EquipmentSlot.WEAPON));
  }

  @Test
  void testEquipItem_replaceExisting() {
    // Equip first weapon
    player.equipItem(EquipmentSlot.WEAPON, "WEAPON-01");

    // Equip second weapon
    String previousItem = player.equipItem(EquipmentSlot.WEAPON, "WEAPON-02");

    assertEquals("WEAPON-01", previousItem);
    assertEquals("WEAPON-02", player.getEquippedItem(EquipmentSlot.WEAPON));
  }

  @Test
  void testUnequipItem_success() {
    // Equip then unequip
    player.equipItem(EquipmentSlot.WEAPON, "WEAPON-01");
    String unequippedItem = player.unequipItem(EquipmentSlot.WEAPON);

    assertEquals("WEAPON-01", unequippedItem);
    assertFalse(player.hasEquippedItem(EquipmentSlot.WEAPON));
    assertNull(player.getEquippedItem(EquipmentSlot.WEAPON));
  }

  @Test
  void testUnequipItem_emptySlot() {
    String unequippedItem = player.unequipItem(EquipmentSlot.WEAPON);

    assertNull(unequippedItem);
  }

  @Test
  void testGetEquippedItems() {
    player.equipItem(EquipmentSlot.WEAPON, "WEAPON-01");
    player.equipItem(EquipmentSlot.ARMOR, "ARMOR-01");

    var equippedItems = player.getEquippedItems();

    assertEquals(2, equippedItems.size());
    assertEquals("WEAPON-01", equippedItems.get(EquipmentSlot.WEAPON));
    assertEquals("ARMOR-01", equippedItems.get(EquipmentSlot.ARMOR));
  }

  @Test
  void testGetTotalAttack_withEquipment() {
    // Base attack is 10 (set in Player constructor)
    assertEquals(10, player.getTotalAttack());

    // Equip weapon with +10 Attack
    player.equipItem(EquipmentSlot.WEAPON, "WEAPON-01");
    assertEquals(20, player.getTotalAttack()); // 10 base + 10 weapon
  }

  @Test
  void testGetTotalDefense_withEquipment() {
    // Base defense is 0 (set in Player constructor)
    assertEquals(0, player.getTotalDefense());

    // Equip armor with +5 Defense
    player.equipItem(EquipmentSlot.ARMOR, "ARMOR-01");
    assertEquals(5, player.getTotalDefense()); // 0 base + 5 armor
  }

  @Test
  void testGetTotalMaxHealth_withEquipment() {
    // Base health is 100 (set in Player constructor)
    assertEquals(100, player.getTotalMaxHealth());

    // Equip artifact with +20 HP
    player.equipItem(EquipmentSlot.ARTIFACT, "ARTIFACT-01");
    assertEquals(120, player.getTotalMaxHealth()); // 100 base + 20 artifact
  }

  @Test
  void testMultipleEquipmentBonuses() {
    // Create items with multiple stat bonuses
    Item multiStatWeapon =
        new Item(
            "MULTI-01",
            "Enchanted Sword",
            "Magical weapon",
            "Weapon",
            "+15 Attack, +3 Defense",
            "");
    Item multiStatArmor =
        new Item("MULTI-02", "Plate Armor", "Heavy armor", "Armor", "+10 Defense, +5 HP", "");

    when(mockWorld.findItem("MULTI-01")).thenReturn(Optional.of(multiStatWeapon));
    when(mockWorld.findItem("MULTI-02")).thenReturn(Optional.of(multiStatArmor));

    // Equip both items
    player.equipItem(EquipmentSlot.WEAPON, "MULTI-01");
    player.equipItem(EquipmentSlot.ARMOR, "MULTI-02");

    // Check total stats
    assertEquals(25, player.getTotalAttack()); // 10 base + 15 weapon
    assertEquals(13, player.getTotalDefense()); // 0 base + 3 weapon + 10 armor
    assertEquals(105, player.getTotalMaxHealth()); // 100 base + 5 armor
  }

  @Test
  void testEquipmentBonuses_itemNotFound() {
    // Equip item that doesn't exist in world
    player.equipItem(EquipmentSlot.WEAPON, "NONEXISTENT");
    when(mockWorld.findItem("NONEXISTENT")).thenReturn(Optional.empty());

    // Should still return base stats
    assertEquals(10, player.getTotalAttack());
    assertEquals(0, player.getTotalDefense());
    assertEquals(100, player.getTotalMaxHealth());
  }

  @Test
  void testEquipmentBonuses_itemWithoutEffect() {
    Item noEffectItem = new Item("NO-EFFECT", "Plain Sword", "Basic sword", "Weapon", "", "");
    when(mockWorld.findItem("NO-EFFECT")).thenReturn(Optional.of(noEffectItem));

    player.equipItem(EquipmentSlot.WEAPON, "NO-EFFECT");

    // Should return base stats (no bonus from item without effect)
    assertEquals(10, player.getTotalAttack());
    assertEquals(0, player.getTotalDefense());
    assertEquals(100, player.getTotalMaxHealth());
  }

  @Test
  void testGetTotalStats_withoutWorld() {
    // Test default implementations that don't require world
    player.equipItem(EquipmentSlot.WEAPON, "WEAPON-01");

    // Should return base stats only (no equipment bonuses without world context)
    assertEquals(10, player.getTotalAttack());
    assertEquals(0, player.getTotalDefense());
    assertEquals(100, player.getTotalMaxHealth());
  }

  @Test
  void testEquipmentSlots() {
    // Test all equipment slots
    assertEquals(3, EquipmentSlot.values().length);
    assertEquals(EquipmentSlot.WEAPON, EquipmentSlot.valueOf("WEAPON"));
    assertEquals(EquipmentSlot.ARMOR, EquipmentSlot.valueOf("ARMOR"));
    assertEquals(EquipmentSlot.ARTIFACT, EquipmentSlot.valueOf("ARTIFACT"));
  }
}
